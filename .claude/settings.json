{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "./.claude/plans/",
  "outputStyle": "Explanatory",
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(./backend/.env.local)"
    ],
    "allow": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
