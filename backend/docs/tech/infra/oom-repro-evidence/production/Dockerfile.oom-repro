# ─────────────────────────────────────────────────────────────
# OOM 재현(무방어) 이미지 — 관측 실험 전용.
#
# 정상 Dockerfile과 빌드 스테이지·애플리케이션 코드가 완전히 동일하며,
# 런타임 ENTRYPOINT에서 JVM 방어 플래그만 제거했다:
#   - MaxRAMPercentage / InitialRAMPercentage (힙 상한·초기 비율)
#   - ExitOnOutOfMemoryError (힙 고갈 시 즉시 종료)
#   - TieredStopAtLevel=1 (기동 CPU 버스트 절감)
# 이 상태의 JVM은 컨테이너 인식 없이 기본 ergonomics로 동작한다
# (문서 "장애 당시" 이미지와 동일). "장애 원인이 코드가 아니라 예산·경계"임을
# 대조하기 위한 실험용이므로, 운영 배포에는 절대 사용하지 않는다.
# ─────────────────────────────────────────────────────────────

# ---- build stage ----
FROM eclipse-temurin:21-jdk AS builder
WORKDIR /app

COPY gradlew .
COPY gradlew.bat .
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./

# 로컬(Windows) 체크아웃 시 gradlew가 CRLF일 수 있어 빌드 중 LF로 정규화(exit 127 방지)
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew
RUN ./gradlew dependencies --no-daemon || true

COPY src/ src/
RUN ./gradlew clean bootJar -x test --no-daemon

# ---- run stage ----
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /app/build/libs/*.jar app.jar
EXPOSE 8080

# 무방어: JVM 방어 플래그 없음 (기본 ergonomics)
ENTRYPOINT ["java", "-jar", "app.jar"]
