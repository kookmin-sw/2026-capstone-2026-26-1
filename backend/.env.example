# 백엔드 로컬 실행용 환경변수 예시.
# 실제 값은 .env.local(git 미추적)에 채운다. 아래 DB/Redis 값은 docker-compose.local.yml로
# 인프라를 띄웠을 때 그대로 쓸 수 있는 하이브리드 로컬 개발용 예시다.
#
#   docker compose -f docker-compose.local.yml up -d
#
# 그 외 키(JWT/Kakao/Naver/Firebase)는 각자 발급받은 값을 넣는다.

# --- DB (docker-compose.local.yml의 mysql: 컨테이너, 호스트 포트 3307) ---
# mysql:8.0은 caching_sha2_password를 쓰므로 비-SSL 로컬 접속에는
# allowPublicKeyRetrieval=true가 반드시 필요하다(없으면 Public Key Retrieval is not allowed).
DB_URL=jdbc:mysql://localhost:3307/capstone?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=gilbut
DB_PASSWORD=1234

JWT_SECRET=

# --- Redis (docker-compose.local.yml의 redis: 컨테이너, 호스트 포트 6380) ---
REDIS_HOST=localhost
REDIS_PORT=6380

KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FIREBASE_CREDENTIALS_PATH=
DDL_AUTO=
